# mock = offline answer writer (no key needed). openai = any OpenAI-compatible API.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. For a local Ollama model: http://localhost:11434/v1
OPENAI_BASE_URL=
MAX_OUTPUT_TOKENS=300

# fastembed = real embedding model on CPU (downloads about 70 MB once). hash = tiny offline stand-in.
EMBEDDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Share of the fused score that comes from meaning search (the rest is keyword search).
DENSE_WEIGHT=0.7
# none = no reranking (default: it measured worse here, see the README). cross-encoder = rerank on CPU.
RERANKER=none
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Refuse when the best passage similarity is under this value. Leave empty for the model's default.
MIN_RELEVANCE=
# Leave empty for the embedded on-disk index. Set to a Qdrant server URL to use a server.
QDRANT_URL=
